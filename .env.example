# Variables de entorno requeridas para el bot CESS
# Copia este archivo como .env para desarrollo local (NUNCA subas .env al repo)

# ── Meta / WhatsApp ──────────────────────────────────────────────────────────
META_TOKEN=tu_token_de_meta_aqui
PHONE_NUMBER_ID=tu_phone_number_id_aqui
VERIFY_TOKEN=vibecode
NUMERO_ASESOR=+526144150015
APP_SECRET=tu_app_secret_de_meta_aqui  # Meta → Tu App → Settings → Basic

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Base de datos ─────────────────────────────────────────────────────────────
# En Render: DATABASE_URL se inyecta automáticamente del addon PostgreSQL
# Para desarrollo local: puedes omitir esta variable (usará SQLite en memoria)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Opcionales ────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o-mini
VENTANA_HISTORIAL=10
MAX_GUARDADOS_POR_NUMERO=30
LOG_LEVEL=INFO
